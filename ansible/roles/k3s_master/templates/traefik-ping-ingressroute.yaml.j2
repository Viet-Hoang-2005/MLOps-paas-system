apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: ping-internal-allowlist
  namespace: kube-system
spec:
  ipAllowList:
    sourceRange: {{ traefik_forwarded_headers_trusted_ips | to_json }}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: traefik-ping-expose
  namespace: kube-system
spec:
  entryPoints:
    - web
  routes:
    - match: Path(`/ping`)
      kind: Rule
      middlewares:
        - name: ping-internal-allowlist
      services:
        - name: ping@internal
          kind: TraefikService

