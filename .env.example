# Python
PYTHONUTF8=1
PYTHONDONTWRITEBYTECODE=1

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=mlops-paas-artifacts
AWS_DEFAULT_REGION=ap-southeast-1

# GitHub
GITHUB_REPO=Viet-Hoang-2005/MLOps-paas-system
GITHUB_TOKEN=

# GitHub OAuth Production
GITHUB_OAUTH2_CLIENT_ID=
GITHUB_OAUTH2_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://mlops-nids-nt114.id.vn/oauth/github/callback

# Google OAuth Credentials
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# Email SMTP
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Django Control Plane
ADMIN_EMAIL=
ADMIN_PASSWORD=
DJANGO_SECRET_KEY=

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

CONTROL_PLANE_AUTOMATIC_DRIFT_WEBHOOK_URL=http://control-plane:8000/internal/webhooks/automatic-drift/
CONTROL_PLANE_WEBHOOK_SECRET=
ARGO_EVENTS_WEBHOOK_TOKEN=

# Messaging
REDPANDA_BROKERS=localhost:19092
KAFKA_TOPIC=mlops_paas_production_data

# Redis
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=
DB_HOST_RW=postgres
DB_HOST_RO=postgres
DB_PORT=5432
DB_NAME=mlops_paas_db

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/oauth/github/callback

# Cloudflare token
TUNNEL_TOKEN=

# Harbor Robot Account
HARBOR_USERNAME='robot$user-images+model-packager'
HARBOR_PASSWORD=
HARBOR_GITHUB_USERNAME='robot$mlops-paas+github-actions'
HARBOR_GITHUB_PASSWORD=
HARBOR_USER_PROJECT=user-images

# Dashboard administrators
ARGOCD_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
HARBOR_ADMIN_PASSWORD=

# Training Configuration
TRAINING_ENABLED=true
TRAINING_GPU_ENABLED=true
TRAINING_GPU_COUNTS=1

# Default execution backend for build, deployment, training, and drift
EXECUTION_BACKEND=docker
# Optional per-workload overrides during a gradual migration:
# BUILD_BACKEND=argo
# DEPLOYMENT_BACKEND=argo
# TRAINING_BACKEND=argo
# DRIFT_BACKEND=argo

# Application container logs: console (default) or json for incident debugging.
LOG_FORMAT=console
LOG_SUMMARY_INTERVAL_SECONDS=60

# User's model project Endpoint
MODEL_PROJECT_API_URL=
MODEL_PROJECT_API_KEY=
