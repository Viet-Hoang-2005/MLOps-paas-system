# OAuth Credentials
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# Email SMTP
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Django Control Plane
DJANGO_SECRET_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,control-plane,api.mlops-nids-nt114.id.vn
CORS_ALLOWED_ORIGINS=https://mlops-nids-nt114.id.vn,http://localhost:5173,http://127.0.0.1:5173
CONTROL_PLANE_INTERNAL_URL=http://control-plane:8000
CONTROL_PLANE_WEBHOOK_URL=http://mlops-paas-control-plane:8000/api/drift/internal/trigger-drift-job
CONTROL_PLANE_WEBHOOK_SECRET=
ARGO_EVENTS_WEBHOOK_TOKEN=

# FastAPI Model Server & Packager
MODEL_SERVER_PUBLIC_URL=http://localhost:5002
MODEL_SERVER_INTERNAL_URL=http://traefik:5000
MODEL_PACKAGER_URL=http://model-packager:7000
DOCKER_NETWORK_NAME=mlops_paas_network

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=NIDS-XGBoost
MLFLOW_DB_SCHEMA=mlflow
MODEL_ID=00000000-0000-0000-0000-000000000001
MODEL_VERSION_ID=00000000-0000-0000-0000-000000000002
MODEL_URI=models:/nids-model/Production
MLFLOW_EXPERIMENT_NAME=mlops-paas-training
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,mlflow,mlflow:5000,mlops_paas_mlflow,mlops_paas_mlflow:5000
MLFLOW_TRACKING_REQUIRED=false
MLFLOW_HTTP_REQUEST_TIMEOUT=10

# Messaging
REDPANDA_BROKERS=localhost:19092
KAFKA_TOPIC=mlops_paas_production_data
CONTROL_PLANE_AUTOMATIC_DRIFT_WEBHOOK_URL=http://control-plane:8000/internal/webhooks/automatic-drift/
AUTOMATIC_DRIFT_OUTBOX_POLL_SECONDS=5
AUTOMATIC_DRIFT_OUTBOX_BATCH_SIZE=50
AUTOMATIC_DRIFT_OUTBOX_LEASE_SECONDS=60
AUTOMATIC_DRIFT_OUTBOX_RETRY_INITIAL_SECONDS=5
AUTOMATIC_DRIFT_OUTBOX_RETRY_MAX_SECONDS=300
AUTOMATIC_DRIFT_OUTBOX_REQUEST_TIMEOUT_SECONDS=10

# PostgreSQL Database
DB_USER=
DB_PASSWORD=
DB_HOST_RW=postgres
DB_HOST_RO=postgres
DB_PORT=5432
DB_NAME=mlops_paas_db
DB_SCHEMA=control_plane

# pgADmin 4 
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Monitoring
DRIFT_THRESHOLD=0.6
EVIDENTLY_TRIGGER_THRESHOLD=100
MIN_SAMPLES=100
MAX_SAMPLES=100000
DRIFT_REPORTS_S3_PREFIX=drift-reports

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/oauth/github/callback

# Cloudflare token
TUNNEL_TOKEN=

# Harbor Robot Account
HARBOR_USERNAME=robot_user-images+model-packager
HARBOR_PASSWORD=
HARBOR_ADMIN_USERNAME=admin
HARBOR_ADMIN_PASSWORD=
HARBOR_GITHUB_USERNAME=robot_mlops-paas+github-actions
HARBOR_GITHUB_PASSWORD=
HARBOR_USER_PROJECT=user-images
HARBOR_REGISTRY_URL=

# Default execution backend for build, deployment, training, and drift
EXECUTION_BACKEND=docker
# Optional per-workload overrides during a gradual migration:
